<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Écrit dans Firebase ce qui a changé dans Odoo (déclenché aussi immédiatement à chaque modification)
             et rejoue les échecs. -->
        <record id="ir_cron_fireman_sync" model="ir.cron">
            <field name="name">Inventory Fireman : file de synchronisation Firebase</field>
            <field name="model_id" ref="model_fireman_sync_event"/>
            <field name="state">code</field>
            <field name="code">model._cron_process()</field>
            <field name="interval_number">5</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
        </record>

        <!-- Filet de sécurité : relit tout Firebase pour rattraper un changement de l'application non signalé. -->
        <record id="ir_cron_fireman_full_pull" model="ir.cron">
            <field name="name">Inventory Fireman : relecture complète Firebase → Odoo</field>
            <field name="model_id" ref="model_fireman_sync_event"/>
            <field name="state">code</field>
            <field name="code">model._cron_full_pull()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">hours</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
