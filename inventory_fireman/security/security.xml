<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_fireman" model="ir.module.category">
        <field name="name">Inventory Fireman</field>
        <field name="sequence">60</field>
    </record>

    <record id="group_fireman_manager" model="res.groups">
        <field name="name">Gestionnaire</field>
        <field name="category_id" ref="module_category_fireman"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="base.group_system" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_fireman_manager'))]"/>
    </record>
</odoo>
