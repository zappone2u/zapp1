<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_report_uo_inventory" model="ir.actions.report">
        <field name="name">Rapport d'inventaire</field>
        <field name="model">fireman.uo</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">inventory_fireman.report_uo_inventory_document</field>
        <field name="report_file">inventory_fireman.report_uo_inventory_document</field>
        <field name="print_report_name">'Rapport_inventaire_%s' % object.code</field>
        <field name="binding_model_id" ref="model_fireman_uo"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_uo_inventory_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="uo">
                <t t-set="report" t-value="uo._reporting_data(50)"/>
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2>Rapport d'inventaire — <t t-out="uo.name"/> (<t t-out="uo.code"/>)</h2>
                        <p class="text-muted">
                            Généré le <t t-out="report['generated_at']" t-options="{'widget': 'datetime'}"/>
                            · Palier <t t-out="uo.tier"/>
                        </p>

                        <table class="table table-sm mt-4">
                            <tr>
                                <td><strong>Inventaires</strong></td><td t-out="report['total']"/>
                                <td><strong>Complets</strong></td><td t-out="report['complete']"/>
                                <td><strong>Incomplets</strong></td><td t-out="report['incomplete']"/>
                            </tr>
                            <tr>
                                <td><strong>Véhicules</strong></td><td t-out="uo.vehicle_count"/>
                                <td><strong>Utilisateurs</strong></td><td t-out="uo.member_count"/>
                                <td/><td/>
                            </tr>
                        </table>

                        <h4 class="mt-4">Par véhicule</h4>
                        <table class="table table-sm">
                            <thead><tr><th>Véhicule</th><th>Inventaires</th><th>Complets</th><th>Dernier inventaire</th></tr></thead>
                            <tbody>
                                <tr t-foreach="report['vehicles']" t-as="line">
                                    <td t-out="line['vehicle'].name"/>
                                    <td t-out="line['total']"/>
                                    <td t-out="line['complete']"/>
                                    <td><t t-out="line['last_date']" t-options="{'widget': 'datetime'}"/></td>
                                </tr>
                            </tbody>
                        </table>

                        <h4 class="mt-4">Derniers manques signalés</h4>
                        <p t-if="not report['lacks']" class="text-muted">Aucun manque signalé.</p>
                        <table t-else="" class="table table-sm">
                            <thead><tr><th>Date</th><th>Véhicule</th><th>Inventoriste</th><th>Manques</th></tr></thead>
                            <tbody>
                                <tr t-foreach="report['lacks']" t-as="inv">
                                    <td t-out="inv.date_text"/>
                                    <td t-out="inv.vehicle_name"/>
                                    <td t-out="inv.inventor_name"/>
                                    <td t-out="inv.lack"/>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
